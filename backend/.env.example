# Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=QualiBoard
DEBUG=true

# MongoDB
MONGODB_URL=mongodb://10.17.154.252:27019
MONGODB_DB_NAME=quality_monitoring
# Optional independent production-fault data gateway (e.g. http://127.0.0.1:18080).
# Leave empty to keep the legacy in-process MongoDB dashboard path.
DATA_GATEWAY_URL=
DATA_GATEWAY_TIMEOUT_SECONDS=15
DATA_GATEWAY_CACHE_TTL_SECONDS=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Legacy SAP HANA view synchronization (scripts/archive/data_sync/sync_views.py)
HANA_ADDRESS=hana.example.internal
HANA_PORT=30015
HANA_USER=readonly_user
HANA_PASSWORD=replace_me
HANA_CONNECT_TIMEOUT=120
SYNC_BATCH_SIZE=1000
SYNC_START_DATE=2026-01-01

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROCESS_RECORD_CREDENTIAL_KEY=

# Authentication and signed-link secrets (required when DEBUG=false)
JWT_SECRET=
ALERT_TOKEN_SECRET=

# Local administrator credentials (required when DEBUG=false)
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

# Must match the secret issued/configured by the OA authentication system
OA_JWT_SECRET=

# Set true when the public frontend is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_ROTATION=500 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=zip
LOG_JSON_FORMAT=false
