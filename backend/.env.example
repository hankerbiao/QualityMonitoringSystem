# Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=QualiBoard
DEBUG=true

# MongoDB
MONGODB_URL=mongodb://10.17.154.252:27019
MONGODB_DB_NAME=quality_monitoring

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROCESS_RECORD_CREDENTIAL_KEY=

# Authentication and signed-link secrets (deploy.sh generates these when empty)
JWT_SECRET=
ALERT_TOKEN_SECRET=

# Local administrator credentials (change before production deployment)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Must match the secret issued/configured by the OA authentication system
OA_JWT_SECRET=

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_ROTATION=500 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=zip
LOG_JSON_FORMAT=false
