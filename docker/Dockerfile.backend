# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY=""
ENV HTTP_PROXY="${HTTP_PROXY}" \
    HTTPS_PROXY="${HTTPS_PROXY}" \
    NO_PROXY="${NO_PROXY}" \
    http_proxy="${HTTP_PROXY}" \
    https_proxy="${HTTPS_PROXY}" \
    no_proxy="${NO_PROXY}"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Cache dependency installation separately from application source changes.
COPY backend/pyproject.toml backend/uv.lock backend/wheels ./
RUN --mount=type=cache,id=qualiboard-uv,target=/root/.cache/uv \
    uv venv .venv && uv pip install --no-deps --no-index $(find . -name "*.whl" | grep -v pyproject | tr '\n' ' ')

COPY --chmod=644 backend/app ./app
COPY --chmod=644 backend/init_default_settings.py ./

RUN chmod -R a+rX /app/app \
    && chmod a+r /app/init_default_settings.py \
    && mkdir -p /app/logs \
    && chown 10001:10001 /app/logs

USER 10001:10001

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
