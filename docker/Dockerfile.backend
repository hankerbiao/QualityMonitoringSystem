# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Cache dependency installation separately from application source changes.
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,id=qualiboard-uv,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY backend/app ./app
COPY backend/init_default_settings.py ./
RUN --mount=type=cache,id=qualiboard-uv,target=/root/.cache/uv \
    uv sync --frozen --no-dev

RUN mkdir -p /app/logs && chown 10001:10001 /app/logs

USER 10001:10001

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
