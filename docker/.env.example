# Host ports and public frontend origin
FRONTEND_PORT=4000
BACKEND_PORT=4001
FRONTEND_ORIGIN=http://localhost:4000
APP_PUBLIC_BASE_URL=https://apps.1oa.com.cn/QualiBoard
TZ=Asia/Shanghai

# Existing external MongoDB service
MONGODB_URL=mongodb://10.17.154.252:27019
MONGODB_DB_NAME=quality_monitoring

# Set every credential below explicitly before deployment.
PROCESS_RECORD_CREDENTIAL_KEY=
JWT_SECRET=
ALERT_TOKEN_SECRET=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
AUTH_COOKIE_SECURE=true

# Mail service integration
MAIL_PROXY_URL=https://one.1oa.com.cn/springboard/api/v1/integrations/mail/app
# Mail API Bearer token, separate from OA_USER_API_KEY
MAIL_PROXY_TOKEN=

# OA employee directory
OA_USER_API_URL=https://central-data.1oa.com.cn/api/v1/centralData/datasets/oa_user
OA_USER_API_KEY=
OA_USER_CACHE_TTL_SECONDS=604800

# Runtime settings
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false
DATA_GATEWAY_TIMEOUT_SECONDS=120
